diff --git a/src/app.ts b/src/app.ts
index c3f7ad2..aa7b795 100644
--- a/src/app.ts
+++ b/src/app.ts
@@ -1,7 +1,13 @@
 import { Hono } from "hono";
+import { z } from "zod";
 import { NoteStore } from "./store.js";
 import { renderPage } from "./views.js";
 
+const newNoteSchema = z.object({
+  title: z.string().trim().min(1).max(120),
+  body: z.string().max(5000).default(""),
+});
+
 function intParam(value: string | undefined): number | undefined {
   if (value === undefined) return undefined;
   const parsed = Number.parseInt(value, 10);
@@ -30,11 +36,21 @@ export function createApp(store = new NoteStore()) {
   });
 
   app.post("/notes", async (c) => {
-    const body = await c.req.json<{ title?: unknown; body?: unknown }>();
-    const note = store.create({
-      title: String(body.title ?? "Untitled"),
-      body: body.body === undefined ? "" : String(body.body),
-    });
+    let json: unknown;
+    try {
+      json = await c.req.json();
+    } catch {
+      return c.json({ error: "invalid JSON" }, 400);
+    }
+    const parsed = newNoteSchema.safeParse(json);
+    if (!parsed.success) {
+      const issues = parsed.error.issues.map((issue) => ({
+        path: issue.path.join("."),
+        message: issue.message,
+      }));
+      return c.json({ error: "invalid note", issues }, 400);
+    }
+    const note = store.create(parsed.data);
     return c.json(note, 201);
   });
 
diff --git a/test/app.test.ts b/test/app.test.ts
index 012b27e..3573889 100644
--- a/test/app.test.ts
+++ b/test/app.test.ts
@@ -42,4 +42,60 @@ describe("notes api", () => {
     expect(html).toContain("Shown on the page");
     expect(html).toContain("1 note");
   });
+
+  describe("POST /notes validation", () => {
+    it("trims the title and defaults the body", async () => {
+      const app = createApp();
+      const res = await post(app, { title: "  Padded  " });
+      expect(res.status).toBe(201);
+      expect(await res.json()).toMatchObject({ title: "Padded", body: "" });
+    });
+
+    it("accepts limits exactly", async () => {
+      const app = createApp();
+      const res = await post(app, { title: "a".repeat(120), body: "b".repeat(5000) });
+      expect(res.status).toBe(201);
+    });
+
+    it("rejects a missing title", async () => {
+      const res = await post(createApp(), { body: "x" });
+      expect(res.status).toBe(400);
+      const json = await res.json();
+      expect(json.error).toBe("invalid note");
+      expect(json.issues).toHaveLength(1);
+      expect(json.issues[0].path).toBe("title");
+    });
+
+    it("rejects a blank or too long title", async () => {
+      const app = createApp();
+      for (const title of ["   ", "", "a".repeat(121)]) {
+        const res = await post(app, { title });
+        expect(res.status).toBe(400);
+        expect((await res.json()).issues[0].path).toBe("title");
+      }
+    });
+
+    it("rejects non-string fields, one issue per problem", async () => {
+      const res = await post(createApp(), { title: 5, body: 7 });
+      expect(res.status).toBe(400);
+      const json = await res.json();
+      expect(json.issues.map((i: { path: string }) => i.path)).toEqual(["title", "body"]);
+    });
+
+    it("rejects a body over 5000 characters", async () => {
+      const res = await post(createApp(), { title: "ok", body: "b".repeat(5001) });
+      expect(res.status).toBe(400);
+      expect((await res.json()).issues[0].path).toBe("body");
+    });
+
+    it("rejects invalid JSON", async () => {
+      const res = await createApp().request("/notes", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: "{not json",
+      });
+      expect(res.status).toBe(400);
+      expect(await res.json()).toEqual({ error: "invalid JSON" });
+    });
+  });
 });
-- 
2.43.0


